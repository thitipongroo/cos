# ============================================================
# Construction OS — E2E / capture harness env template
# ============================================================
# Scope: variables read ONLY by the test + screenshot harness —
#   tests/e2e/**            Playwright web E2E (spec §30.5, 10 scenarios)
#   apps/mobile/e2e/**      Detox mobile E2E (spec §30.5/§30.7, 3 scenarios)
#   scripts/capture*        screenshot / interaction capture scripts
#
# These are deliberately NOT in the root `.env`: that file is application runtime config, and
# mixing test credentials into it would put throwaway logins next to production settings.
#
# EVERY variable here has a working in-code default — the suites run with none of them set.
# Override only when your environment differs (different ports, seeded users, a remote target).
# The "# default:" line under each entry is the value the code falls back to, copied from source.
#
# Usage:  cp tests/e2e/.env.example tests/e2e/.env    then export them, e.g.
#         set -a; . tests/e2e/.env; set +a; pnpm exec playwright test
#
# ⚠ The default passwords below are throwaway values already hardcoded in the specs. They are
# valid ONLY against a locally seeded dev database. Never point this harness at production, and
# never replace these defaults with a real credential — CI injects real values as secrets.
# ============================================================

# ─── Targets ──────────────────────────────────────────────
# Backend API base used by API-level setup calls.
# default: http://localhost:3000
BASE_URL=http://localhost:3000
# Web app base used by the Playwright browser context. WEB_BASE and WEB_BASE_URL are read by
# different capture scripts and carry the same default — keep them identical.
# default: http://localhost:3001
WEB_BASE=http://localhost:3001
# default: http://localhost:3001
WEB_BASE_URL=http://localhost:3001
# Base used by the mobile capture/login helper. NOTE: its in-code default is port 3001 (the WEB
# port), not 3000 — kept verbatim here rather than "corrected", since changing it would alter
# harness behaviour. default: http://localhost:3001
E2E_API_URL=http://localhost:3001
# Optional bearer token for API-level setup calls. Empty = unauthenticated setup path.
# default: (empty)
E2E_API_TOKEN=

# ─── Generic login (used where the spec does not need a specific role) ───
# default: e2e-admin@construction-os.io
E2E_EMAIL=e2e-admin@construction-os.io
# default: E2eTestPass123!
E2E_PASSWORD=E2eTestPass123!

# ─── Per-role Path B logins (email + password via Keycloak) ───
# One pair per RBAC role exercised by the 10 web scenarios.
# default: e2e-admin@construction-os.io / E2eTestPass123!
E2E_ADMIN_EMAIL=e2e-admin@construction-os.io
E2E_ADMIN_PASSWORD=E2eTestPass123!
# default: e2e-pm@construction-os.io / E2eTestPass123!
E2E_PM_EMAIL=e2e-pm@construction-os.io
E2E_PM_PASSWORD=E2eTestPass123!
# Read by a different spec than E2E_PM_PASSWORD and carries the same default — the two names are
# NOT interchangeable in code, so both must be set if you change the PM password.
# default: E2eTestPass123!
E2E_PM_EMAIL_PASSWORD=E2eTestPass123!
# default: e2e-exec@construction-os.io / E2eTestPass123!
E2E_EXEC_EMAIL=e2e-exec@construction-os.io
E2E_EXEC_PASSWORD=E2eTestPass123!
# default: e2e-finance@construction-os.io / E2eTestPass123!
E2E_FINANCE_EMAIL=e2e-finance@construction-os.io
E2E_FINANCE_PASSWORD=E2eTestPass123!
# default: e2e-procurement@construction-os.io / E2eTestPass123!
E2E_PROC_EMAIL=e2e-procurement@construction-os.io
E2E_PROC_PASSWORD=E2eTestPass123!
# default: e2e-safety@construction-os.io / E2eTestPass123!
E2E_SAFETY_EMAIL=e2e-safety@construction-os.io
E2E_SAFETY_PASSWORD=E2eTestPass123!
# default: e2e-engineer@construction-os.io / E2eTestPass123!
E2E_SE_EMAIL=e2e-engineer@construction-os.io
E2E_SE_PASSWORD=E2eTestPass123!
# default: e2e-inspector@construction-os.io / E2eTestPass123!
E2E_INSPECTOR_EMAIL=e2e-inspector@construction-os.io
E2E_INSPECTOR_PASSWORD=E2eTestPass123!

# ─── Path A logins (phone + SMS OTP — field roles) ────────
# The OTP itself comes from the backend E2E bypass: set E2E_AUTH_BYPASS=true and E2E_TEST_OTP in
# the ROOT .env (already documented there) so the flow accepts a fixed OTP without live SMS.
# default: +66800000001
E2E_WORKER_PHONE=+66800000001
# default: +66800000003
E2E_USER_A_PHONE=+66800000003
# default: +66800000004
E2E_INSPECTOR_PHONE=+66800000004
# ⚠ E2E_OTP_PHONE has THREE different in-code defaults depending on which spec reads it
# (0811000002, 0811000009, 0811000010) — there is no single correct value. Leave it UNSET so each
# spec keeps its own default; setting it forces every one of them onto the same seeded user.
# default: (per-spec — see above)
E2E_OTP_PHONE=

# ─── Demo / capture data ──────────────────────────────────
# Seeded demo tenant login used by the screenshot capture scripts.
# default: wichai.e@ekachai.co.th
E2E_DEMO_EMAIL=wichai.e@ekachai.co.th
# default: Ekachai@2026
DEMO_USER_PASSWORD=Ekachai@2026
# Fixed task UUID the mobile capture flow expects to exist in the seeded DB.
# default: e2e-task-001
E2E_TEST_TASK_ID=e2e-task-001
# Project UUID used by scripts/capture-graph.mjs.
# default: 88803908-e4b5-57bd-8e6b-ed4662b5d67d
PID=88803908-e4b5-57bd-8e6b-ed4662b5d67d
# Display names the "reset" capture flow searches for in the seeded data.
# default: Chalermsak Nithat
RESET_EMAIL_TARGET=Chalermsak Nithat
# default: Somchai
RESET_TEMP_TARGET=Somchai
# Capture the <LoadingState /> variants too. Enabled only when EXACTLY '1'.
# default: (unset ⇒ skipped)
CAPTURE_LOADING=

# ─── Offline-sync benchmark (G1 envelope, ADR-048) ────────
# Record count and output path for the sync throughput benchmark.
# default: 500
G1_N=500
# default: the OS temp dir
G1_OUT=

# ─── Android toolchain (Detox only) ───────────────────────
# Path to the Android SDK. ANDROID_HOME is tried first, then ANDROID_SDK_ROOT; both empty means
# the Detox helper cannot locate adb/emulator. Normally exported by your shell profile from the
# SDK install — set here only if you keep the SDK somewhere non-standard.
# default: (empty)
ANDROID_HOME=
# default: (empty)
ANDROID_SDK_ROOT=

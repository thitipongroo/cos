    "@digitalbazaar/security-document-loader": "^3.2.0",
    "@digitalbazaar/vc": "^7.3.0",
    "@digitalbazaar/vc-status-list": "^8.0.1",
    "@digitalbazaar/vc-status-list-context": "^3.1.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.2.1",

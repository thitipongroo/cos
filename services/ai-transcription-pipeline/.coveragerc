# Coverage config for the QM-1 line-coverage gate (--cov-fail-under=99).
# Tests are omitted: measuring a suite against itself inflates the figure — including tests/
# reported 45-87% for these services where the source alone is 35-73%.
[run]
branch = False
omit =
    tests/*
    */site-packages/*
    setup.py

[report]
exclude_lines =
    pragma: no cover
    # the module-run guard is executed by the interpreter, never by an import under test
    if __name__ == .__main__.:
show_missing = True
skip_covered = False

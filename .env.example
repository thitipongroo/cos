# ============================================================
# Construction OS — Environment Variables
# Copy to .env for local development: cp .env.example .env
# NEVER commit .env to git — it is gitignored
# In production: all secrets injected via AWS Secrets Manager
# (cloud/EKS) or HashiCorp Vault (on-premise) — see ADR-013
# ============================================================

# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cos
POSTGRES_PASSWORD=cos_dev_password
POSTGRES_DB=construction_os

# Application connects via PgBouncer (QM-18) — NEVER directly to 5432
DATABASE_URL=postgresql://cos:cos_dev_password@localhost:6432/construction_os

# ─── PgBouncer ────────────────────────────────────────────
PGBOUNCER_PORT=6432

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cos_redis_password
REDIS_URL=redis://:cos_redis_password@localhost:6379

# ─── Kafka ────────────────────────────────────────────────
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=cos-backend
KAFKA_GROUP_ID=cos-backend-group

# ─── Confluent Schema Registry ────────────────────────────
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_PORT=8081

# ─── Keycloak ─────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8443
KEYCLOAK_REALM=cos-platform
KEYCLOAK_CLIENT_ID=cos-backend
KEYCLOAK_CLIENT_SECRET=REPLACE_ME

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME_WITH_SECURE_SECRET_MIN_64_CHARS
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# ─── AWS SNS (OTP SMS) ────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
SNS_OTP_SENDER_ID=COS

# ─── OpenSearch ───────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200

# ─── Neo4j ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cos_neo4j_password

# ─── ClickHouse ───────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=cos
CLICKHOUSE_PASSWORD=cos_ch_password

# ─── MinIO / S3 ───────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ROOT_USER=cos_minio
MINIO_ROOT_PASSWORD=cos_minio_password
MINIO_CONSOLE_PORT=9101

# ─── HashiCorp Vault (local dev only) ─────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_DEV_ROOT_TOKEN=cos-vault-root-token

# ─── Temporal ─────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cos-main
TEMPORAL_UI_PORT=8088

# ─── OpenAI (AI services only) ────────────────────────────
OPENAI_API_KEY=REPLACE_ME
OPENAI_ORG_ID=REPLACE_ME

# ─── Cloudflare WAF (production only) ─────────────────────
CLOUDFLARE_ZONE_ID=REPLACE_ME
CLOUDFLARE_API_TOKEN=REPLACE_ME

# ─── SonarQube (CI/CD) ────────────────────────────────────
SONAR_HOST_URL=http://localhost:9009
SONAR_TOKEN=REPLACE_ME

# ─── Feature Flags (AWS AppConfig) ────────────────────────
APPCONFIG_APP_ID=REPLACE_ME
APPCONFIG_ENV_ID=REPLACE_ME
APPCONFIG_PROFILE_ID=REPLACE_ME

# ─── Observability ────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cos-backend

# ─── Kafka UI ─────────────────────────────────────────────
KAFKA_UI_PORT=8080

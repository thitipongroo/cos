# ============================================================
# Construction OS — Environment Variables  (canonical template)
# ============================================================
# The canonical reference of every variable that must be SET, covering dev / staging /
# production. Values below are the working DEVELOP defaults; where a variable
# differs per environment, an inline "# staging: … / production: …" comment gives
# the other shapes.
#
# SCOPE: every variable listed here is read by application code. Two kinds:
#   • REPLACE_ME / REPLACE_ME_* — NO safe in-code default. Unset ⇒ the feature throws, fails, or
#     silently does nothing. These must be filled in before that feature is used.
#   • a line preceded by "# default: X" — the code already falls back to X when unset, so the value
#     below is safe to leave as-is; it is listed only so the surface is discoverable and overridable.
#
# ONE deliberate omission: TESTCONTAINERS_RYUK_DISABLED. It is ASSIGNED by the test file itself
# (packages/@cos/shared/test/kafka/kafka.integration.spec.ts sets process.env[...] = 'true') and is
# never read from the environment, so listing it here would be false documentation.
#
# Two-file scheme (only these two exist — spec §08):
#   .env.example   ← THIS file — the committed template (dev / staging / prod)   [committed]
#   .env           ← the concrete, active file each environment fills            [gitignored]
#
# Set up any environment by copying the template and filling in that env's values:
#   cp .env.example .env      # (make env-init does this if .env is missing)
# then edit .env — for dev the defaults already work; for staging/production set
# the values from the "# staging:/production:" comments and pull secrets from Vault/SM.
# docker-compose and the apps read `.env`.
#
# KEEP IN SYNC: `.env` and `.env.example` must carry the SAME KEYS. Add a variable
# to one → add it to the other (a new key in `.env.example` needs a value in `.env`,
# and any key the app reads from `.env` must be documented here).
#
# NEVER commit `.env` (gitignored). Real staging/production NEVER run from a file:
# secrets are injected at runtime via AWS Secrets Manager (cloud/EKS) or HashiCorp
# Vault (on-premise) through the Helm chart (QM-4, spec §5.2 / §08). A value marked
# REPLACE_ME_* here is a placeholder — a real secret must never be committed.
# ============================================================

# ─── App ──────────────────────────────────────────────────
# staging/production: NODE_ENV=production, LOG_LEVEL=info
NODE_ENV=development
PORT=3000
FILE_SERVICE_PORT=3002
LOG_LEVEL=debug
# Comma-separated allowed CORS origins (backend/src/main.ts). QM-4 forbids `*` in production.
# default: http://localhost:3001
CORS_ORIGINS=http://localhost:3001
# apps/web middleware: 'true' sends Content-Security-Policy, anything else sends
# Content-Security-Policy-Report-Only. Staging runs report-only, production enforces (spec §16).
# default: (unset ⇒ report-only)
CSP_ENFORCE=false

# ─── App-service host ports (docker-compose `apps` profile — ADR-036) ─────
# Host ports for the FastAPI services when run via `make docker-apps-up-full`. The Go
# workers (analytics-worker, kg-ingestion-worker) are internal-only — no host port.
AI_GATEWAY_PORT=8000
AI_EMBEDDING_PORT=8001
AI_OCR_PORT=8002
AI_TRANSCRIPTION_PORT=8003
# Self-host reverse-geocode (Nominatim, 'full' profile). Backend reads NOMINATIM_URL.
# Host port must not be 8081 — that is SCHEMA_REGISTRY_PORT below, and both run in the 'full' profile.
NOMINATIM_PORT=8082
NOMINATIM_PASSWORD=cos_nominatim_password
NOMINATIM_URL=http://nominatim:8080
# AI gateway → backend flag endpoint (server-evaluated flags — ADR-049; QM-15).
# Unset = kill-switches fail open (local dev / degraded mode).
BACKEND_FLAGS_URL=http://localhost:3000/api/v1/flags

# ─── Internal service URLs (cross-deployable HTTP) ────────
# In-cluster DNS names are the code defaults, so they work unchanged in Kubernetes. Point them at
# localhost only when running a service on the host while its callers run in containers.
# default: http://file-service:3002
FILE_SERVICE_URL=http://file-service:3002
# default: http://credential-service:3009
CREDENTIAL_SERVICE_URL=http://credential-service:3009
# Read by the MLOps model-promotion job to reach the gateway.
# default: http://cos-ai-gateway.cos.svc.cluster.local:8000
AI_GATEWAY_URL=http://cos-ai-gateway.cos.svc.cluster.local:8000

# ─── PostgreSQL ───────────────────────────────────────────
# staging/production: POSTGRES_HOST = the cluster DB host (from Helm values / Vault); never localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cos
POSTGRES_PASSWORD=cos_dev_password
POSTGRES_DB=construction_os

# Application connects via PgBouncer (QM-18) — NEVER directly to 5432
DATABASE_URL=postgresql://cos:cos_dev_password@localhost:6432/construction_os
# Tenant-scoped app connection — non-superuser app_user role so PostgreSQL RLS is enforced (ADR-031).
# Local-dev password set by migration 20260623000001_app_user_login_and_grants; prod injects via Vault/SM.
APP_DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:6432/construction_os
# Direct (non-pooled) connection for Prisma migrations — bypasses PgBouncer
DIRECT_DATABASE_URL=postgresql://cos:cos_dev_password@localhost:5432/construction_os

# ─── PgBouncer ────────────────────────────────────────────
PGBOUNCER_PORT=6432

# ─── Redis ────────────────────────────────────────────────
# staging/production: REDIS_HOST = the cluster Redis host (Helm/Vault); never localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cos_redis_password
REDIS_URL=redis://:cos_redis_password@localhost:6379

# ─── Kafka ────────────────────────────────────────────────
# staging/production: KAFKA_BROKERS = the cluster brokers (e.g. host:9092); never localhost:29092.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=cos-backend
KAFKA_GROUP_ID=cos-backend-group
# Host port docker-compose publishes for the external listener (must match KAFKA_BROKERS above).
KAFKA_PORT=29092
# Applied by KafkaProducer when it creates a topic on first publish, and to a tenant's DLQ on first
# failure (topics are never auto-created by the broker — spec §7.3). Production uses RF=3 / minISR=2.
# default: 3
KAFKA_TOPIC_PARTITIONS=3
# default: 1   — production: 3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ─── Confluent Schema Registry ────────────────────────────
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_PORT=8081

# ─── Keycloak ─────────────────────────────────────────────
# staging:     KEYCLOAK_URL=https://auth.staging.construction-os.io
# production:  KEYCLOAK_URL=https://auth.construction-os.io
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_PORT=8090
# Dev imports realm `construction-os-dev`. staging/production use the shared realm `construction-os`
# (QM-4, spec §5/§7.6); ENTERPRISE tenants get a dedicated realm cos-{tenantCode} (Phase 25).
KEYCLOAK_REALM=construction-os-dev
KEYCLOAK_CLIENT_ID=cos-backend
# Dev: the cos-backend secret from the imported dev realm (local, safe). staging/production: Vault/SM.
KEYCLOAK_CLIENT_SECRET=cos-backend-secret-dev
# Keycloak 26 initial-admin bootstrap (KC_BOOTSTRAP_ADMIN_*) — first container init only, local dev.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cos_keycloak_admin
# Admin REST client used by KeycloakAdminService to provision users (Phase 2 Path A/B).
# KEYCLOAK_ADMIN_CLIENT_ID defaults to cos-backend in code. The SECRET has NO safe default:
# the service THROWS on startup when it is unset with NODE_ENV=production (Vault/SM injects it);
# outside production it falls back to the dev realm secret.
KEYCLOAK_ADMIN_CLIENT_SECRET=cos-backend-secret-dev
# default: cos-backend
KEYCLOAK_ADMIN_CLIENT_ID=cos-backend
# `aud` claim the JWT strategy requires. Must match the audience mapper in the realm.
# default: cos-backend
KEYCLOAK_AUDIENCE=cos-backend
# MFA enforcement (QM-4: MFA REQUIRED for TENANT-ADMIN + FINANCE). MFA_ENFORCE defaults to FALSE,
# so MFA is NOT enforced unless this is explicitly 'true' — set it to true in staging/production.
# MFA_REQUIRED_ACR is the Keycloak ACR level the token must carry once enforcement is on.
# default: false
MFA_ENFORCE=false
# default: gold
MFA_REQUIRED_ACR=gold

# ─── Web app — next-auth (apps/web) ───────────────────────
# Path B OIDC against Keycloak; Path A OTP via backend /auth/otp/*.
# staging:     NEXTAUTH_URL=https://app.staging.construction-os.io
# production:  NEXTAUTH_URL=https://app.construction-os.io
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=REPLACE_ME_WITH_SECURE_SECRET_MIN_32_CHARS
# staging:     KEYCLOAK_ISSUER=https://auth.staging.construction-os.io/realms/construction-os
# production:  KEYCLOAK_ISSUER=https://auth.construction-os.io/realms/construction-os
KEYCLOAK_ISSUER=http://localhost:8090/realms/construction-os-dev
KEYCLOAK_WEB_CLIENT_ID=cos-web
# cos-web is a PUBLIC client (PKCE, no client secret) in the realm import
# (infrastructure/keycloak/realms/construction-os-realm.json → publicClient: true, no `secret`),
# so this is intentionally EMPTY in every environment — there is no secret to inject.
KEYCLOAK_WEB_CLIENT_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME_WITH_SECURE_SECRET_MIN_64_CHARS
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# ─── App-layer secret encryption (AES-256-GCM) ────────────
# 32-byte key as 64 hex chars — encrypts secrets at rest above DB SSE-KMS (e.g. MFA TOTP seeds).
# REQUIRED in production (injected via AWS Secrets Manager / Vault). Generate: openssl rand -hex 32
APP_SECRET_ENCRYPTION_KEY=REPLACE_ME_WITH_64_HEX_CHARS

# ─── External-party token secrets (HMAC-signed magic links) ───
# HMAC-SHA256 keys for tokens that authenticate external parties WITHOUT a platform account.
# These keys are the SOLE authenticity control for the tokens — leaking or defaulting them lets
# anyone forge cross-tenant tokens. REQUIRED in production: each service THROWS on startup when its
# var is unset with NODE_ENV=production. A dev-only fallback is used solely for local/test.
#   CONTRACT_SIGN_SECRET — client contract-signing links (finance, ADR-058 CT-4)
#   VENDOR_PORTAL_SECRET — vendor-portal invitation + session tokens (ADR-030)
# Generate: openssl rand -hex 32
CONTRACT_SIGN_SECRET=REPLACE_ME_WITH_64_HEX_CHARS
VENDOR_PORTAL_SECRET=REPLACE_ME_WITH_64_HEX_CHARS

# ─── CredentialService (W3C DID/VC, ADR-019) ──────────────
# Public base domain for did:web. Every tenant issuer DID is did:web:{domain}:tenants:{tenant_id},
# resolved at https://{domain}/tenants/{tenant_id}/did.json, and every revocable VC embeds
# https://{domain}/tenants/{tenant_id}/status-lists/{id}. Both are permanently baked into credentials
# already issued — changing this domain invalidates them. REQUIRED (no default).
# did:web mandates HTTPS, so a deployed host must be TLS-terminated. Keep the LOCAL value here: a dev
# machine that copied a real domain would mint DIDs claiming to be that deployment. The real values are
# set per environment in infrastructure/helm/cos-credential-service/values-{staging,prod}.yaml
# (credentials-staging. / credentials.construction-os.io) — never from a .env file.
DID_WEB_BASE_DOMAIN=credentials.localhost
CREDENTIAL_SERVICE_PORT=3009

# ─── AWS SNS (OTP SMS) ────────────────────────────────────
# Primary region is ap-southeast-7 (Bangkok) per QM-5 / QM-13 / GLOB-001; ap-southeast-1 (Singapore) is DR.
AWS_REGION=ap-southeast-7
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
SNS_OTP_SENDER_ID=COS

# ─── OpenSearch ───────────────────────────────────────────
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200
# Initial admin password for the local OpenSearch container. OpenSearch 3.x enforces a strong
# password policy (upper + lower + digit + symbol) and refuses to start if it is not met.
OPENSEARCH_PASSWORD=Cos_Os_Dev_2024!

# ─── Neo4j ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
# Bearer token for kg-ingestion-worker POST /admin/rebuild (replays the whole topic from the
# oldest offset). The worker fails CLOSED when this is unset: the endpoint refuses every
# request. Leave blank locally unless you actually need to trigger a rebuild.
KG_ADMIN_TOKEN=
NEO4J_USER=neo4j
# NEO4J_USERNAME — read by the backend app (matches k8s secret schema);
# NEO4J_USER is the docker-compose NEO4J_AUTH variable. Keep both = neo4j.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cos_neo4j_password

# ─── ClickHouse ───────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# CLICKHOUSE_URL — HTTP interface endpoint read by the backend app (matches k8s
# secret schema); derived from CLICKHOUSE_HOST + CLICKHOUSE_HTTP_PORT.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=cos
CLICKHOUSE_PASSWORD=cos_ch_password

# ─── MinIO / S3 ───────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ROOT_USER=cos_minio
MINIO_ROOT_PASSWORD=cos_minio_password
MINIO_CONSOLE_PORT=9101

# ─── ClamAV (antivirus — file-service) ───────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# default: 60000
CLAMAV_TIMEOUT_MS=60000

# ─── File service limits (Phase 9) ────────────────────────
# Signed download-URL lifetime. Spec §Phase 9 states 1 hour.
# default: 3600
SIGNED_URL_TTL_SECONDS=3600
# Zip-bomb guards applied during sandboxed archive extraction (Phase 9 bulk upload):
# entry count, max decompression ratio, and max total uncompressed bytes.
# default: 1000
ZIP_MAX_ENTRIES=1000
# default: 100
ZIP_MAX_RATIO=100
# default: 524288000  (500 MB)
ZIP_MAX_TOTAL_BYTES=524288000

# ─── HashiCorp Vault (local dev only) ─────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN=cos-vault-root-token

# ─── Temporal ─────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cos-main
TEMPORAL_UI_PORT=8088

# ─── EMQX MQTT broker (IoT ingestion — Phase 21/24) ───────
# Open-source EMQX self-hosted; IoT device → EMQX → IoT Ingestion Worker → Kafka (spec §13.5, §33.8).
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083

# ─── MailHog (local dev SMTP sink) ────────────────────────
# Catches outbound email locally so no real mail is sent from a dev machine.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ─── OpenAI (AI services only) ────────────────────────────
# staging/production: real keys injected via Vault/SM — never committed.
OPENAI_API_KEY=REPLACE_ME
OPENAI_ORG_ID=REPLACE_ME

# ─── AI Gateway auth (GW-001) ─────────────────────────────
# AI_GATEWAY_VIRTUAL_KEY — the gateway's virtual API key. FAILS OPEN: when it is empty every caller
# is accepted (intended for local dev). Set it in staging/production or the gateway is unauthenticated.
# AI_GATEWAY_INTERNAL_TOKEN — sent as X-Internal-Token by the MLOps model-promotion job
# (mlops/serving/update_gateway.py); that script reads it with os.environ[...] and raises KeyError if unset.
AI_GATEWAY_VIRTUAL_KEY=
AI_GATEWAY_INTERNAL_TOKEN=REPLACE_ME

# ─── AI Gateway runtime (Phase 11/12) ─────────────────────
# Chain YAML dir. Service-local is canonical (PO decision 2026-07-21) — the repo-root ai/chains/ copy
# was merged in and deleted. default: <services/ai-gateway>/ai/chains
AI_CHAINS_DIR=
# Jinja2 prompt templates. When unset the loader walks up to find an ai/prompts dir and RAISES
# FileNotFoundError if it finds none — the ai-gateway image bakes ai/prompts in at /app/ai/prompts.
# default: (auto-discovered by walking up)
PROMPTS_DIR=
# pgvector DSN for RAG retrieval. Falls back to DATABASE_URL when unset; RAG is disabled entirely if
# neither is set. default: (falls back to DATABASE_URL)
RAG_DATABASE_URL=
# Base URL for the self-hosted Ollama swap-in of LLMProvider (AlternativeLLMProvider, spec §22.6).
# default: http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
# Digital Twin Kafka consumer (Phase 24). OFF unless set to 1/true — the twin layer must not block
# Phase 15–19, so it stays disabled by default. default: (unset ⇒ disabled)
DIGITAL_TWIN_CONSUMER_ENABLED=false

# ─── AI transcription — faster-whisper (self-hosted STT) ──
# The pipeline uses a STUB transcriber unless STT_PROVIDER=faster_whisper, so voice notes are not
# actually transcribed with the default value. default: stub
STT_PROVIDER=stub
# default: small
WHISPER_MODEL_SIZE=small
# default: cpu
WHISPER_DEVICE=cpu
# default: int8
WHISPER_COMPUTE_TYPE=int8

# ─── Notification channels (Phase 20 — spec §19.2/§19.7) ──
# All three have NO safe default: each adapter logs a warning and SILENTLY SKIPS delivery when unset,
# so email/LINE notifications simply never arrive. Required in staging/production (Vault/SM).
# SendGrid is the MVP email adapter; AWS SES replaces it before Stage 2 go-live (spec §19.7).
SENDGRID_API_KEY=REPLACE_ME
SENDGRID_FROM_EMAIL=REPLACE_ME
# LINE Messaging API push. MVP uses this single tenant-wide token; per-tenant token lands in Stage 2.
LINE_CHANNEL_ACCESS_TOKEN=REPLACE_ME

# ─── Finance — FX rates (Open Exchange Rates) ─────────────
# Multi-currency conversion source (00_master FINANCIAL PRECISION SPEC). No safe default: the app id is
# interpolated into the request URL, so an unset value makes every rate refresh fail with an API error.
# Rates cache in Redis TTL 24h with stale-while-revalidate fallback to the last cached rate.
OPEN_EXCHANGE_RATES_APP_ID=REPLACE_ME
# AR client-billing approval ceiling (spec §15.5: PM approves up to the limit, Executive above it).
# Units are the billing currency's major unit. default: 500000
BILLING_PM_APPROVAL_MAX=500000
# Public base URL embedded in client contract-signing magic links (ADR-058). The default is a
# placeholder host — set the real public app URL per environment or clients receive unusable links.
# default: https://app.cos.local
CONTRACT_SIGN_URL_BASE=http://localhost:3001

# ─── Procurement — fallback approver IDs (spec §15.5) ─────
# Used to seed the PO approval chain when a tenant has not configured its own approvers. The defaults
# are placeholder all-zero UUIDs — they resolve to no real user, so approval notifications go nowhere.
# Set real user_ids per environment before the procurement approval flow is used in anger.
# default: 00000000-0000-0000-0000-000000000001
DEFAULT_PM_APPROVER_ID=00000000-0000-0000-0000-000000000001
# default: 00000000-0000-0000-0000-000000000002
DEFAULT_FINANCE_APPROVER_ID=00000000-0000-0000-0000-000000000002
# default: 00000000-0000-0000-0000-000000000003
DEFAULT_EXECUTIVE_APPROVER_ID=00000000-0000-0000-0000-000000000003
# default: 00000000-0000-0000-0000-000000000004
DEFAULT_TENANT_ADMIN_ID=00000000-0000-0000-0000-000000000004

# ─── Mobile sync (Phase 10) ───────────────────────────────
# Retention for platform.sync_tombstones rows backing GET /sync/delta `deleted[]`. A non-numeric or
# non-positive value falls back to the default rather than throwing. default: 90
SYNC_TOMBSTONE_RETENTION_DAYS=90

# ─── Weather (OpenWeatherMap) ─────────────────────────────
# Auto-pulls the weather condition on site-report creation (context/01 Priority 1 weather spec).
# The provider factory treats BOTH an empty value AND the literal REPLACE_ME as absent and falls back
# to StubWeatherProvider, so local dev works unconfigured.
WEATHER_API_KEY=REPLACE_ME

# ─── Platform webhook (Phase 25 — spec §34.6) ─────────────
# HMAC-SHA256 key verifying POST /api/v1/platform/webhooks/enterprise-contract-signed.
# No default: the service throws 500 on every request while unset. Generate: openssl rand -hex 32
PLATFORM_WEBHOOK_SECRET=REPLACE_ME_WITH_64_HEX_CHARS

# ─── Enterprise provisioning — dedicated RDS (Phase 25) ───
# Used by EnterpriseProvisioningWorkflow createRdsActivity.
#
# NOTE: there is deliberately NO password variable here any more (security review F4/F9). The instance
# is created with ManageMasterUserPassword=true, so AWS generates the master password and stores it in
# Secrets Manager; provisioning reads it from the ARN on DBInstance.MasterUserSecret. The RLS-enforcing
# app_user credential is a per-tenant secret the workflow creates and reads at
# `cos/{NODE_ENV}/tenant-db/{tenantCode}/app_user`. The removed TENANT_DB_MASTER_PASSWORD never held the
# real password — the instance's password was AWS-managed from the start.
#
# The Temporal worker's IAM role therefore needs: secretsmanager:GetSecretValue, CreateSecret, TagResource.
#
# The two below only matter in AWS (subnet group defaults to cos-tenant-subnet-group in code; security
# groups default to an empty list). Cloud only — leave blank for local dev.
TENANT_DB_SUBNET_GROUP=cos-tenant-subnet-group
TENANT_DB_SECURITY_GROUP_IDS=
# KMS CMK for the tenant's dedicated RDS instance. Resolution order in code is
# TENANT_KMS_KEY_{TENANT_CODE_UPPERCASE} first, then this fallback; unset ⇒ AWS default key.
# The per-tenant form is dynamic and therefore cannot be enumerated here — set it per tenant in the
# Helm values / Secrets Manager when that tenant needs its own CMK (QM-4, spec §5.2.1).
# default: (unset)
DEFAULT_TENANT_KMS_KEY=

# ─── Cloudflare WAF (production only) ─────────────────────
# production: real values injected via Vault/SM.
CLOUDFLARE_ZONE_ID=REPLACE_ME
CLOUDFLARE_API_TOKEN=REPLACE_ME

# ─── SAST (CI/CD) ─────────────────────────────────────────
# No variables required. CodeQL and Semgrep CE both run on the built-in GITHUB_TOKEN in CI
# (.github/workflows/codeql.yml, semgrep.yml); jscpd is configured by .jscpd.json. SonarQube and its
# SONAR_HOST_URL / SONAR_TOKEN were removed — see ADR-019.
# Local run:  semgrep --config .semgrep/     and     pnpm exec jscpd backend/src packages

# ─── Feature Flags (Unleash — ADR-049; QM-15) ─────────────
# Leave UNLEASH_URL unset for local dev — FeatureFlagService then serves registry defaults
# (docs/feature-flags/registry.md) without an Unleash server.
UNLEASH_URL=
UNLEASH_API_TOKEN=REPLACE_ME
UNLEASH_APP_NAME=cos-backend

# ─── Observability ────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cos-backend
# OTel Collector tail-sampling baseline, in PERCENT 0–100 (1 = 1%). Consumed ONLY by the Collector
# (infrastructure/monitoring/otel-collector/), never by application code — no SDK samples anymore
# (ADR-075). Per spec §31.5: development=100, staging=10, production=1.
# Renamed from OTEL_SAMPLING_RATIO, which was a ratio (0.01) — copying the old value here would
# under-sample by 100x. Collector 0.103.0 has no default syntax, so the Deployment must set it.
OTEL_SAMPLING_PERCENTAGE=1
# Port the backend exposes the Prometheus exporter on. default: 9464
PROMETHEUS_PORT=9464
# Reported as service.version on every span. default: 0.0.0
SERVICE_VERSION=0.0.0

# ─── MLOps (Phase 23 — Airflow / MLflow jobs) ─────────────
# Read by mlops/ scripts with os.environ[...] — they raise KeyError when unset. These run in the
# MLOps environment, not in the app pods; leave blank locally unless running an export/promotion job.
MLFLOW_TRACKING_URI=REPLACE_ME
# Direct PostgreSQL DSN for the training-data export (mlops/data_export/export_to_parquet.py).
POSTGRES_URI=REPLACE_ME
# S3/MinIO credentials for the data-lake export. Separate from MINIO_ROOT_* above, which are the
# local container's root credentials — these are the job's own access key pair.
MINIO_ENDPOINT_URL=REPLACE_ME
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME

# ─── Integration-test opt-in gates (local only) ───────────
# The Digital Twin sync integration test SKIPS unless both are set to a real Postgres DSN / Redis URL.
# Leave blank — set them only when you want that test to actually run.
TWIN_TEST_PG=
TWIN_TEST_REDIS=

# ─── Kafka UI ─────────────────────────────────────────────
KAFKA_UI_PORT=8080

# ─── E2E / test auth bypass (LOCAL & TEST ONLY — read by backend otp.service) ───
# DANGER: E2E_AUTH_BYPASS=true makes the OTP flow accept a fixed, deterministic OTP so automated
# e2e/capture runs work without live SMS. It is DOUBLE-GATED in code — honoured only when
# NODE_ENV !== 'production' — but it MUST stay false (or unset) outside a developer machine.
# E2E_TEST_OTP is the fixed OTP accepted while the bypass is on (backend default '123456').
E2E_AUTH_BYPASS=false
E2E_TEST_OTP=123456

# ─── Mobile (Expo) Path B OIDC — Keycloak public client (ADR-050) ───
# NOTE: Expo inlines EXPO_PUBLIC_* at bundle time from apps/mobile/.env — it does NOT read this
# root file. apps/mobile keeps its own .env / .env.example (Expo build constraint). These two are
# duplicated here only so the root template documents the full surface; the mobile app uses its own.
# Mobile OIDC discovery issuer + public client (PKCE). The client must be provisioned in Keycloak
# with redirect URI cos://oauth2redirect. Defaults target the local dev realm.
# staging:     EXPO_PUBLIC_KEYCLOAK_ISSUER=https://auth.staging.construction-os.io/realms/construction-os
# production:  EXPO_PUBLIC_KEYCLOAK_ISSUER=https://auth.construction-os.io/realms/construction-os
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8090/realms/construction-os-dev
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=cos-mobile
# Backend API base the mobile app calls (api/client.ts, api/transcribe.ts, sync/runPushSync.ts).
# On a physical device localhost is the DEVICE, not your machine — set your LAN IP there.
# default: http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Detox E2E hook. Detox has NO connectivity API, so offline is simulated by an app-level hook gated
# on this var (deep link cos://e2e/network) — spec §17.8 / §30.7. Every mutator is a no-op unless
# this is exactly '1', so the hook is inert in production. default: (unset ⇒ inert)
EXPO_PUBLIC_E2E=
# Screenshot/capture builds: mutes the dev LogBox toast AND freezes every animation loop at a fixed
# frame so captures are deterministic.
# ⚠ MUST BE LEFT EMPTY to disable. The two read sites disagree: _layout.tsx compares === '1', but
# LoadingState.tsx uses a bare truthiness check — so EXPO_PUBLIC_CAPTURE=0 still FREEZES animations.
# Only an empty/unset value turns it off. default: (unset ⇒ off)
EXPO_PUBLIC_CAPTURE=
# Mobile-side gate for the MFA-enrollment entry in the navigation drawer. Enabled only when === '1'.
# default: (unset ⇒ hidden)
EXPO_PUBLIC_FF_S1_AUTH_MFA_ENROLLMENT=

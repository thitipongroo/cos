# ============================================================
# Construction OS — PRODUCTION overlay  (branch: main / production)
# ------------------------------------------------------------
# OVERLAY, not a full env file. `make use-env APP_ENV=production` builds
# .env.production = .env.example (base)  +  this overlay  (last value wins),
# then copies it to .env. Only vars that DIFFER from .env.example belong here.
#
# ⚠️  PRODUCTION IS NEVER RUN FROM A .env FILE. Every value below marked
#     REPLACE_ME_* is injected at runtime via HashiCorp Vault (on-premise) /
#     AWS Secrets Manager (cloud) through Helm values-prod.yaml (QM-4, spec §5.2 /
#     §08). This template exists ONLY to document the production shape and to let a
#     developer simulate a production-like config LOCALLY. Committing a real
#     production secret here is a security incident — keep real values in Vault/SM
#     and any local copy in .env.production (gitignored).
# ============================================================

# ─── ENV marker ───────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─── Hosts — production DNS ───────────────────────────────
POSTGRES_HOST=REPLACE_ME_PROD_DB_HOST
REDIS_HOST=REPLACE_ME_PROD_REDIS_HOST
KAFKA_BROKERS=REPLACE_ME_PROD_KAFKA:9092
KEYCLOAK_URL=https://auth.construction-os.io
NEXTAUTH_URL=https://app.construction-os.io

# ─── Keycloak — shared realm (QM-4: STARTER/PROFESSIONAL = construction-os;
#     ENTERPRISE tenants get a dedicated realm cos-{tenantCode}, Phase 25) ──────
KEYCLOAK_REALM=construction-os
KEYCLOAK_ISSUER=https://auth.construction-os.io/realms/construction-os
EXPO_PUBLIC_KEYCLOAK_ISSUER=https://auth.construction-os.io/realms/construction-os

# ─── Secrets — injected via Vault/SM on-cluster (never a committed value) ───
KEYCLOAK_CLIENT_SECRET=REPLACE_ME_VAULT
KEYCLOAK_WEB_CLIENT_SECRET=REPLACE_ME_VAULT
NEXTAUTH_SECRET=REPLACE_ME_VAULT
JWT_SECRET=REPLACE_ME_VAULT
APP_SECRET_ENCRYPTION_KEY=REPLACE_ME_VAULT
CONTRACT_SIGN_SECRET=REPLACE_ME_VAULT
VENDOR_PORTAL_SECRET=REPLACE_ME_VAULT
OPENAI_API_KEY=REPLACE_ME_VAULT
CLOUDFLARE_ZONE_ID=REPLACE_ME_VAULT
CLOUDFLARE_API_TOKEN=REPLACE_ME_VAULT

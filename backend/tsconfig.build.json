{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {},
    // Keep the incremental cache inside dist so nest-cli's `deleteOutDir: true`
    // clears it together with the output. Otherwise a stale root-level
    // tsconfig.build.tsbuildinfo makes tsc skip emit after dist is deleted,
    // leaving no dist/main.js for `node dist/main`.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}

{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "plugins": ["@stryker-mutator/jest-runner"],
  "inPlace": true,
  "testRunner": "jest",
  "jest": { "configFile": "jest.config.js" },
  "mutate": [
    "src/modules/procurement/procurement.service.ts",
    "src/modules/procurement/workflows/po.activities.ts",
    "src/modules/procurement/workflows/rfq.activities.ts",
    "src/shared/guards/**/*.ts",
    "!src/**/__tests__/**",
    "!src/**/*.spec.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": { "high": 90, "low": 80, "break": 70 },
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "tempDirName": ".stryker-tmp"
}

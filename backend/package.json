{
  "name": "@cos/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Construction OS — NestJS Modular Monolith",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPatterns='src/'",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:workflows": "jest --config jest.workflows.config.js",
    "test:cov": "jest --coverage",
    "test:mutation": "stryker run",
    "test:watch": "jest --watch",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "studio": "prisma studio"
  },
  "dependencies": {

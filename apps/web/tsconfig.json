{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "outDir": ".next",
    "rootDir": "../..",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    // Includes the jest globals so `tsc --noEmit` type-checks src/**/__tests__ alongside the app,
    // matching apps/mobile/tsconfig.json (§35.13 ESC-25).
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "next.config.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/app/sw.ts"]
}

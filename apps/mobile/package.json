{
  "name": "@cos/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "detox test --configuration ios.sim.release",
    "test:e2e:android": "detox test --configuration android.emu.release",
    "build:e2e:ios": "detox build --configuration ios.sim.release",
    "build:e2e:android": "detox build --configuration android.emu.release",
    "capture:android": "node scripts/capture-android-login.mjs",
    "capture:android:transparency": "node scripts/capture-android-transparency.mjs",
    "capture:android:privacy-policy": "node scripts/capture-android-privacy-policy.mjs",
    "capture:android:home": "node scripts/capture-android-home.mjs",
    "capture:android:tenant-admin-home": "node scripts/capture-android-tenant-admin-home.mjs",
    "capture:android:site-worker": "node scripts/capture-android-site-worker.mjs"
  },
  "dependencies": {
    "@cos/financial": "file:../../packages/@cos/financial",
    "@cos/schemas": "file:../../packages/@cos/schemas",

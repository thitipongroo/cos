{
  "name": "@cos/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "detox test --configuration ios.sim.release",
    "test:e2e:android": "detox test --configuration android.emu.release",
    "build:e2e:ios": "detox build --configuration ios.sim.release",
    "build:e2e:android": "detox build --configuration android.emu.release"
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cos/types": "file:../../packages/@cos/types",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo/config-plugins": "~8.0.11",
    "@morrowdigital/watermelondb-expo-plugin": "^2.3.3",
    "@nozbe/simdjson": "3.9.4",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.35.0",
    "axios": "^1.7.0",
    "babel-preset-expo": "~56.0.16",
    "expo": "~56.0.13",
    "expo-asset": "~56.0.18",
    "expo-background-fetch": "~56.0.20",
    "expo-battery": "~56.0.4",
    "expo-build-properties": "~56.0.20",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.19",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.19",
    "expo-router": "~56.2.12",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.11",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.20",
    "intl-messageformat": "^10.7.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@config-plugins/detox": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "detox": "^20.13.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@nozbe/simdjson"
      ]
    },
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "@expo/config-plugins"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb"
        ],
        "listUnknownPackages": false
      }
    }
  }
}

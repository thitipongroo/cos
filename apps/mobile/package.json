    "detox": "^20.13.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "@expo/config-plugins"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }

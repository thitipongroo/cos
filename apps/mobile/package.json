    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.20",
    "expo-web-browser": "~56.0.5",
    "intl-messageformat": "^10.7.0",
    "react": "19.2.3",

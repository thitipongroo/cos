# ============================================================
# Construction OS — Mobile (apps/mobile, Expo) env template
# ============================================================
# Two-file scheme (only these two exist — spec §08):
#   apps/mobile/.env.example  ← THIS committed template (dev / staging / prod)  [committed]
#   apps/mobile/.env          ← concrete active file, filled per environment     [gitignored]
# Set up:  cp apps/mobile/.env.example apps/mobile/.env   then fill values (dev defaults already work).
# KEEP IN SYNC: apps/mobile/.env and apps/mobile/.env.example must carry the SAME KEYS.
#
# Expo INLINES every EXPO_PUBLIC_* var into the JS bundle at Metro start — these are PUBLIC by
# design and must NEVER hold a secret. The mobile app is a Keycloak public OIDC client (PKCE,
# ADR-050); it has no client secret. Point the issuer at the realm that actually exists for the
# environment — the local Keycloak imports `construction-os-dev`, so the dev default targets it
# (the code default falls back to `construction-os`, which 404s locally).
# ============================================================

# staging:     EXPO_PUBLIC_KEYCLOAK_ISSUER=https://auth.staging.construction-os.io/realms/construction-os
# production:  EXPO_PUBLIC_KEYCLOAK_ISSUER=https://auth.construction-os.io/realms/construction-os
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8090/realms/construction-os-dev
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=cos-mobile

# ─── Backend API base ─────────────────────────────────────
# Read by src/api/client.ts, src/api/transcribe.ts and src/sync/runPushSync.ts.
# On a PHYSICAL DEVICE `localhost` resolves to the device itself, not your laptop — use your
# machine's LAN IP (e.g. http://192.168.1.20:3000/api/v1) or the app cannot reach the backend.
# staging:     EXPO_PUBLIC_API_URL=https://api.staging.construction-os.io/api/v1
# production:  EXPO_PUBLIC_API_URL=https://api.construction-os.io/api/v1
# default: http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── Detox E2E hook (LOCAL & TEST ONLY) ───────────────────
# Detox has NO connectivity API (device.setStatusBar is cosmetic and the NetInfo jest mock is
# unit-only), so offline is simulated by an app-level hook: deep link cos://e2e/network?online=0|1
# → networkOverride → useNetworkStatus (spec §17.8 / §30.7). Every mutator and subscription is a
# no-op unless this is EXACTLY '1', so the hook is inert in a production bundle.
# MUST stay empty outside a Detox run. default: (unset ⇒ inert)
EXPO_PUBLIC_E2E=

# ─── Screenshot / capture builds (LOCAL ONLY) ─────────────
# Mutes the dev LogBox toast AND freezes every animation loop at a fixed frame for deterministic
# captures.
# ⚠ MUST BE LEFT EMPTY to disable. The two read sites disagree: src/app/_layout.tsx compares
# === '1', but src/components/LoadingState.tsx uses a bare truthiness check — so
# EXPO_PUBLIC_CAPTURE=0 still FREEZES animations. Only empty/unset turns it off.
# default: (unset ⇒ off)
EXPO_PUBLIC_CAPTURE=

# ─── Data Protection Office contact (PDPA §37) ────────────
# Address shown by the pre-auth Privacy Policy screen ((auth)/privacy-policy) as the channel for
# access / portability / erasure / restriction requests.
# Deliberately NOT hardcoded: the DPO is an external appointment made at the Stage 2→3 gate
# (docs/compliance/data-flow-map.md § Review schedule; spec §5.3), so at Stage 1 there is no address
# to ship. PDPA §37(3) requires the controller contact to be genuinely reachable — a placeholder
# would be a false statement on a legal notice.
# Unset ⇒ the contact row renders DISABLED and states that no address is published yet.
# Set this the day the DPO is appointed; no code change is required.
# default: (unset ⇒ contact row disabled)
EXPO_PUBLIC_DPO_EMAIL=support@construction-os.com

# ─── Mobile feature flags ─────────────────────────────────
# Shows the MFA-enrollment entry in the navigation drawer. Enabled only when EXACTLY '1'.
# Mobile flags are build-time inlined, unlike the server-evaluated Unleash flags used by the
# backend (ADR-049) — flipping this needs a rebuild, not a flag toggle.
# default: (unset ⇒ hidden)
EXPO_PUBLIC_FF_S1_AUTH_MFA_ENROLLMENT=

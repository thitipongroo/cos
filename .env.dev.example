# ============================================================
# Construction OS — DEVELOP overlay  (branch: develop)
# ------------------------------------------------------------
# This is an OVERLAY, not a full env file. `make use-env APP_ENV=dev`
# builds .env.dev = .env.example (base)  +  this overlay  (last value wins),
# then copies it to .env. Only the vars that DIFFER from .env.example for the
# develop environment belong here — keep it small so the real diff is legible.
#
# Local secrets are dev defaults (safe to keep in .env.dev, which is gitignored).
# NEVER commit .env.dev — only this *.example template is committed.
# ============================================================

# ─── ENV marker ───────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Keycloak — DEV realm ─────────────────────────────────
# The dev stack imports realm `construction-os-dev` (infrastructure/keycloak/realms/).
# Staging/production use the canonical shared realm `construction-os` (QM-4, spec §5/§7.6).
KEYCLOAK_REALM=construction-os-dev
KEYCLOAK_ISSUER=http://localhost:8090/realms/construction-os-dev
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8090/realms/construction-os-dev
# cos-backend client secret from the imported dev realm file.
KEYCLOAK_CLIENT_SECRET=cos-backend-secret-dev

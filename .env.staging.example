# ============================================================
# Construction OS — STAGING overlay  (branch: staging)
# ------------------------------------------------------------
# OVERLAY, not a full env file. `make use-env APP_ENV=staging` builds
# .env.staging = .env.example (base)  +  this overlay  (last value wins),
# then copies it to .env. Only vars that DIFFER from .env.example belong here.
#
# ⚠️  REAL staging is NOT run from this file. On the staging cluster every value
#     below marked REPLACE_ME_* is injected at runtime via HashiCorp Vault
#     (on-premise) / AWS Secrets Manager (cloud) through the Helm chart
#     values-staging.yaml (QM-4, spec §5.2 / §08). This overlay exists only so a
#     developer can run the stack LOCALLY in a staging-like shape. NEVER put a real
#     staging secret in a committed file — keep it in .env.staging (gitignored).
# ============================================================

# ─── ENV marker ───────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─── Hosts — staging DNS (fill locally, or leave for Helm on-cluster) ─────
POSTGRES_HOST=REPLACE_ME_STAGING_DB_HOST
REDIS_HOST=REPLACE_ME_STAGING_REDIS_HOST
KAFKA_BROKERS=REPLACE_ME_STAGING_KAFKA:9092
KEYCLOAK_URL=https://auth.staging.construction-os.io
NEXTAUTH_URL=https://app.staging.construction-os.io

# ─── Keycloak — shared realm (QM-4: STARTER/PROFESSIONAL = construction-os) ──
KEYCLOAK_REALM=construction-os
KEYCLOAK_ISSUER=https://auth.staging.construction-os.io/realms/construction-os
EXPO_PUBLIC_KEYCLOAK_ISSUER=https://auth.staging.construction-os.io/realms/construction-os

# ─── Secrets — injected via Vault/SM on-cluster (never a committed value) ───
KEYCLOAK_CLIENT_SECRET=REPLACE_ME_VAULT
KEYCLOAK_WEB_CLIENT_SECRET=REPLACE_ME_VAULT
NEXTAUTH_SECRET=REPLACE_ME_VAULT
JWT_SECRET=REPLACE_ME_VAULT
APP_SECRET_ENCRYPTION_KEY=REPLACE_ME_VAULT
CONTRACT_SIGN_SECRET=REPLACE_ME_VAULT
VENDOR_PORTAL_SECRET=REPLACE_ME_VAULT

{
  "type": "record",
  "name": "SafetyViolationDetectedEvent",
  "namespace": "com.constructionos.events.safety",
  "doc": "safety.violation.detected.v1 — spec §19.6 (one of two notifications that cannot be disabled) and §20.2 Violation alerts; two producers: the permit-expiry sweep and a failed safety checklist",
  "fields": [
    { "name": "event_id",       "type": "string" },
    { "name": "event_type",     "type": "string" },
    { "name": "event_version",  "type": "string" },
    { "name": "tenant_id",      "type": "string" },
    { "name": "actor_id",       "type": "string", "doc": "'system' for the permit sweep — no human triggers a lapse on a clock" },
    { "name": "occurred_at",    "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "trace_id",       "type": ["null", "string"], "default": null },
    { "name": "span_id",        "type": ["null", "string"], "default": null },
    { "name": "payload", "type": {
      "type": "record", "name": "SafetyViolationDetectedPayload",
      "fields": [
        { "name": "violation_type",   "type": { "type": "enum", "name": "SafetyViolationType", "symbols": ["PERMIT_EXPIRED", "CHECKLIST_ITEM_FAILED"] },
          "doc": "PPE_NON_COMPLIANCE is reserved for SafetyVisionModel (§22.6) and is NOT emitted — the model is untrained (Phase 23 threshold: 10,000+ labelled photos)" },
        { "name": "project_id",       "type": "string" },
        { "name": "detected_by",      "type": "string", "doc": "PERMIT_EXPIRY_SWEEP | CHECKLIST_SUBMISSION" },
        { "name": "detail",           "type": "string", "doc": "Human-readable summary for the notification body" },
        { "name": "permit_id",        "type": ["null", "string"], "default": null },
        { "name": "permit_number",    "type": ["null", "string"], "default": null },
        { "name": "permit_type",      "type": ["null", "string"], "default": null },
        { "name": "linked_task_id",   "type": ["null", "string"], "default": null },
        { "name": "inspection_id",    "type": ["null", "string"], "default": null },
        { "name": "checklist_id",     "type": ["null", "string"], "default": null },
        { "name": "failed_item_count","type": ["null", "int"],    "default": null }
      ]
    }}
  ]
}

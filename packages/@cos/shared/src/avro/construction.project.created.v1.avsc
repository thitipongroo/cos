{
  "type": "record",
  "name": "ProjectCreatedEvent",
  "namespace": "com.constructionos.events.construction",
  "doc": "construction.project.created.v1 — spec §32.4 event #1",
  "fields": [
    { "name": "event_id",       "type": "string" },
    { "name": "event_type",     "type": "string" },
    { "name": "event_version",  "type": "string" },
    { "name": "tenant_id",      "type": "string" },
    { "name": "actor_id",       "type": "string" },
    { "name": "occurred_at",    "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "trace_id",       "type": ["null", "string"], "default": null },
    { "name": "span_id",        "type": ["null", "string"], "default": null },
    { "name": "payload", "type": {
      "type": "record", "name": "ProjectCreatedPayload",
      "fields": [
        { "name": "project_id",   "type": "string" },
        { "name": "project_code", "type": "string" },
        { "name": "project_name", "type": "string" },
        { "name": "project_type", "type": { "type": "enum", "name": "ProjectType",
            "symbols": ["RESIDENTIAL", "COMMERCIAL", "INFRASTRUCTURE", "INDUSTRIAL"] } },
        { "name": "budget", "type": {
          "type": "record", "name": "MoneyAmount",
          "fields": [
            { "name": "amount",        "type": "string", "doc": "decimal string, 4dp" },
            { "name": "currency_code", "type": "string", "doc": "ISO 4217" }
          ]
        }},
        { "name": "start_date", "type": "string", "doc": "YYYY-MM-DD" },
        { "name": "end_date",   "type": "string", "doc": "YYYY-MM-DD" },
        { "name": "created_by", "type": "string", "doc": "UUID" }
      ]
    }}
  ]
}

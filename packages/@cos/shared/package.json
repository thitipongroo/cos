{
  "name": "@cos/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:unit": "jest --testPathPattern='src/'",
    "test:integration": "jest --testPathPattern='test/'",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@cos/logger": "workspace:*",
    "@cos/types": "workspace:*",
    "kafkajs": "^2.2.0",
    "ioredis": "^5.3.0",
    "@kafkajs/confluent-schema-registry": "^3.3.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0",
    "testcontainers": "^10.9.0",
    "@testcontainers/kafka": "^10.9.0"
  }
}

{
  "name": "@cos/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && pnpm run copy:avro",
    "dev": "pnpm run copy:avro && tsc --watch --project tsconfig.build.json",
    "copy:avro": "node scripts/copy-avro.mjs",
    "type-check": "tsc --noEmit",
    "clean": "node ../../../scripts/rimraf-dist.mjs",
    "test": "jest --testPathPatterns='src/'",
    "test:unit": "jest --testPathPatterns='src/'",
    "test:integration": "jest --testPathPatterns='test/'",
    "test:cov": "jest --coverage --testPathPatterns='src/'"
  },
  "dependencies": {
    "@cos/logger": "workspace:*",
    "@cos/types": "workspace:*",
    "@kafkajs/confluent-schema-registry": "^3.3.0",
    "ioredis": "^5.3.0",
    "kafkajs": "^2.2.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@testcontainers/kafka": "^10.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.0",
    "jest": "^30.4.2",
    "testcontainers": "^10.9.0",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3"
  }
}

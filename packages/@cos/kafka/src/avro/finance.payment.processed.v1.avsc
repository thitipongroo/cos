{
  "type": "record",
  "name": "PaymentProcessedEvent",
  "namespace": "com.constructionos.events.finance",
  "doc": "finance.payment.processed.v1 — Phase 7 Finance Service",
  "fields": [
    { "name": "event_id",       "type": "string" },
    { "name": "event_type",     "type": "string" },
    { "name": "event_version",  "type": "string" },
    { "name": "tenant_id",      "type": "string" },
    { "name": "actor_id",       "type": "string" },
    { "name": "occurred_at",    "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "trace_id",       "type": ["null", "string"], "default": null },
    { "name": "span_id",        "type": ["null", "string"], "default": null },
    { "name": "payload", "type": {
      "type": "record", "name": "PaymentProcessedPayload",
      "fields": [
        { "name": "project_id",    "type": "string" },
        { "name": "payment_id",    "type": "string" },
        { "name": "invoice_id",    "type": "string" },
        { "name": "amount",        "type": "string" },
        { "name": "currency_code", "type": "string" },
        { "name": "payment_date",  "type": "string" }
      ]
    }}
  ]
}

{
  "type": "record",
  "name": "IssueCreatedEvent",
  "namespace": "com.constructionos.events.site",
  "doc": "site.issue.created.v1 — Phase 6 Site Operations",
  "fields": [
    { "name": "event_id",       "type": "string" },
    { "name": "event_type",     "type": "string" },
    { "name": "event_version",  "type": "string" },
    { "name": "tenant_id",      "type": "string" },
    { "name": "actor_id",       "type": "string" },
    { "name": "occurred_at",    "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "trace_id",       "type": ["null", "string"], "default": null },
    { "name": "span_id",        "type": ["null", "string"], "default": null },
    { "name": "payload", "type": {
      "type": "record", "name": "IssueCreatedPayload",
      "fields": [
        { "name": "issue_id",    "type": "string" },
        { "name": "project_id",  "type": "string" },
        { "name": "report_id",   "type": ["null", "string"], "default": null },
        { "name": "title",       "type": "string" },
        { "name": "severity", "type": { "type": "enum", "name": "IssueSeverity",
            "symbols": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] } },
        { "name": "created_by",  "type": "string" }
      ]
    }}
  ]
}

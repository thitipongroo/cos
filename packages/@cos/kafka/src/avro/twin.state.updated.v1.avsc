        { "name": "tenant_id",    "type": "string" },
        { "name": "recorded_at",  "type": "string" },
        { "name": "source",       "type": { "type": "enum", "name": "StateSource", "symbols": ["IOT", "MANUAL", "AI_INFERRED"] } },
        { "name": "confidence",   "type": "double" }
      ]
    }}
  ]
}

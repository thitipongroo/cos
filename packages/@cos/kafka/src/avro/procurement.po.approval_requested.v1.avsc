{
  "type": "record",
  "name": "PurchaseOrderApprovalRequestedEvent",
  "namespace": "com.constructionos.events.procurement",
  "doc": "procurement.po.approval_requested.v1 — Phase 5 Procurement Service",
  "fields": [
    { "name": "event_id",       "type": "string" },
    { "name": "event_type",     "type": "string" },
    { "name": "event_version",  "type": "string" },
    { "name": "tenant_id",      "type": "string" },
    { "name": "actor_id",       "type": "string" },
    { "name": "occurred_at",    "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "trace_id",       "type": ["null", "string"], "default": null },
    { "name": "span_id",        "type": ["null", "string"], "default": null },
    { "name": "payload", "type": {
      "type": "record", "name": "PurchaseOrderApprovalRequestedPayload",
      "fields": [
        { "name": "po_id",         "type": "string" },
        { "name": "project_id",    "type": "string" },
        { "name": "approver_id",   "type": "string" },
        { "name": "tier",          "type": "string" },
        { "name": "po_number",     "type": "string" },
        { "name": "total_amount",  "type": "string" },
        { "name": "currency_code", "type": "string" }
      ]
    }}
  ]
}

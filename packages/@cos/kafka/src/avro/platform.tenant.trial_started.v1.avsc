{
  "type": "record",
  "name": "TenantTrialStartedEvent",
  "namespace": "com.constructionos.events.platform",
  "doc": "platform.tenant.trial_started.v1 — §7.10 / ADR-109. A free-trial tenant was opened (TRIAL). Platform-scope: rides the shared platform.events topic.",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "event_version",
      "type": "string"
    },
    {
      "name": "tenant_id",
      "type": "string",
      "doc": "Always the 'platform' sentinel; the tenant is payload.tenant_id"
    },
    {
      "name": "actor_id",
      "type": "string",
      "doc": "SYSTEM_ADMIN user_id who opened the trial"
    },
    {
      "name": "occurred_at",
      "type": "string"
    },
    {
      "name": "correlation_id",
      "type": "string"
    },
    {
      "name": "trace_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "span_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "TenantTrialStartedPayload",
        "fields": [
          {
            "name": "tenant_id",
            "type": "string",
            "doc": "UUID of the trial tenant"
          },
          {
            "name": "tenant_code",
            "type": "string"
          },
          {
            "name": "plan_type",
            "type": {
              "type": "enum",
              "name": "PlanType",
              "symbols": [
                "STARTER",
                "PROFESSIONAL",
                "ENTERPRISE",
                "LITE"
              ]
            },
            "doc": "The plan being trialled"
          },
          {
            "name": "trial_started_at",
            "type": "string",
            "doc": "ISO 8601"
          },
          {
            "name": "trial_ends_at",
            "type": "string",
            "doc": "ISO 8601 — trial_started_at + 30 days"
          },
          {
            "name": "trial_source",
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "doc": "construction-os.io CTA the request came from"
          }
        ]
      }
    }
  ]
}

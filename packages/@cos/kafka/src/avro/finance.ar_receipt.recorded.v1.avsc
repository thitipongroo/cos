{
  "type": "record",
  "name": "ArReceiptRecordedEvent",
  "namespace": "com.constructionos.events.finance",
  "doc": "finance.ar_receipt.recorded.v1 — Phase 7 Finance Service (an AR receipt recorded; one per receipt — the billing turns PAID when its receipts reach its amount, plan DF)",
  "fields": [
    { "name": "event_id",       "type": "string" },
    { "name": "event_type",     "type": "string" },
    { "name": "event_version",  "type": "string" },
    { "name": "tenant_id",      "type": "string" },
    { "name": "actor_id",       "type": "string" },
    { "name": "occurred_at",    "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "trace_id",       "type": ["null", "string"], "default": null },
    { "name": "span_id",        "type": ["null", "string"], "default": null },
    { "name": "payload", "type": {
      "type": "record", "name": "ArReceiptRecordedPayload",
      "fields": [
        { "name": "ar_receipt_id",   "type": "string" },
        { "name": "billing_id",      "type": "string" },
        { "name": "project_id",      "type": "string" },
        { "name": "amount_received", "type": "string" },
        { "name": "billing_status",  "type": ["null", "string"], "default": null,
          "doc": "The billing after this receipt: ISSUED (part-received) or PAID (fully received) — plan DF" }
      ]
    }}
  ]
}

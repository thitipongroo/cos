{
  "name": "@cos/test-utils",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "node ../../../scripts/rimraf-dist.mjs",
    "test": "jest --testPathPatterns='src/'",
    "test:unit": "jest --testPathPatterns='src/'",
    "test:cov": "jest --testPathPatterns='src/' --coverage"
  },
  "dependencies": {
    "@testcontainers/clickhouse": "^10.9.0",
    "@testcontainers/kafka": "^10.9.0",
    "@testcontainers/minio": "^10.9.0",
    "@testcontainers/neo4j": "^10.9.0",
    "@testcontainers/postgresql": "^10.9.0",
    "@testcontainers/redis": "^10.9.0",
    "pg": "^8.21.0",
    "testcontainers": "^10.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.1.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "testcontainers": "^10.9.0"
  }
}

# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
build
.next
out
coverage

# next-pwa generated service worker (build artifacts emitted to apps/web/public; hash varies per build)
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/workbox-*.js
apps/web/public/workbox-*.js.map
apps/web/public/fallback-*.js

# Environment
.env
.env.local
.env.*.local
!.env.example

# Secrets — never commit these
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer

# OS
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo

# Turbo
.turbo

# TypeScript
*.tsbuildinfo
# Compiled JS artifacts inside src/ — outDir is dist/, never src/
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Python
__pycache__
*.py[cod]
*.egg-info
.venv
venv
.pytest_cache
.mypy_cache

# Go module vendor directories (services/*/vendor). The bare pattern also matches the web app's
# /vendor route, so the negation below keeps the Vendor Portal frontend tracked (ADR-030).
vendor
!/apps/web/src/app/vendor/

# Prisma
backend/prisma/migrations/**/migration_lock.toml

# Docker
.docker

# Test artifacts
test-results
playwright-report

# cos-audit (content is git-ignored, directory committed)
cos-audit/*
!cos-audit/.gitkeep

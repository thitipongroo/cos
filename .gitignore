# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
build
.next
out
coverage

# Lighthouse CI reports (apps/web/.lighthouseci) — `lhci autorun` writes ~5.7 MB of lhr-*.json /
# lhr-*.html per run. CI uploads this directory as a workflow artifact
# (.github/workflows/lighthouse.yml), so it is build output, never source.
.lighthouseci

# coverage.py data/report artifacts (Python services). `coverage` above only matches a path named
# exactly that, so the dotfile data file and the generated reports were NOT ignored — running
# `pytest --cov` in any service left a committable SQLite file behind. `.coveragerc` is CONFIG and
# stays tracked, so it must not be caught by these patterns.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Expo local state/cache (apps/mobile) — regenerated per machine, must not be committed (expo-doctor)
.expo/

# next-env.d.ts is generated by Next.js and rewritten by every `next dev` / `next build` /
# `next typegen` — its `import './.next/…/types/routes.d.ts'` line differs between dev and build, so a
# tracked copy produces a diff every time a developer switches commands. Next's own guidance:
# "next-env.d.ts is managed by Next.js. Its contents are an implementation detail and may change over
# time. Add it to .gitignore. If your project already tracks the file, remove it from Git."
# (https://nextjs.org/docs/app/api-reference/config/typescript). It stays in tsconfig.json `include`.
apps/web/next-env.d.ts

# Serwist (@serwist/turbopack) serves the service worker from the /serwist/[path] route handler
# (bundled into .next at build time), so no service-worker artifacts land in apps/web/public — ADR-047.
# The former next-pwa public/ artifacts (sw.js, workbox-*.js, fallback-*.js) are no longer generated.

# Environment
.env
.env.local
.env.*.local
!.env.example

# Secrets — never commit these
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer

# OS
.DS_Store
Thumbs.db

# IDE
# .vscode
.idea
*.swp
*.swo

# Turbo
.turbo

# TypeScript
*.tsbuildinfo
# Compiled JS artifacts inside src/ — outDir is dist/, never src/
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Python
__pycache__
*.py[cod]
*.egg-info
.venv
venv
.pytest_cache
.mypy_cache

# Go module vendor directories (services/*/vendor). The bare pattern also matches the web app's
# /vendor route, so the negation below keeps the Vendor Portal frontend tracked (ADR-030).
vendor
!/apps/web/src/app/vendor/

# Prisma
backend/prisma/migrations/**/migration_lock.toml

# Docker
.docker

# Test artifacts
test-results
playwright-report
# Pact consumer contracts — generated by contract tests (tests/contract); regenerated each run
pacts

# cos-audit (content is git-ignored, directory committed)
cos-audit/*
!cos-audit/.gitkeep

# Stryker mutation testing artifacts (QM-1)
# Leading-slash-free patterns that contain a slash are anchored to this file's directory, so a bare
# `reports/mutation/` only ignored the repo root. Mutation runs are per-package
# (`pnpm --filter @cos/financial test:mutation` → packages/@cos/financial/reports/mutation/), so the
# pattern must match at any depth or every run leaves an untracked ~250 KB HTML report behind.
**/.stryker-tmp/
**/reports/mutation/

# Terraform working state. `terraform init` downloads provider binaries into .terraform/ (hundreds
# of MB) and plan/apply write tfstate — none of it belongs in git, and none of it was ignored, so a
# single `terraform init` left committable artifacts behind.
# .terraform.lock.hcl is deliberately NOT ignored: HashiCorp's guidance is to commit the provider
# lock file so every environment resolves identical provider versions.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override_*.tf

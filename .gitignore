# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
build
.next
out
coverage

# Lighthouse CI reports (apps/web/.lighthouseci) — `lhci autorun` writes ~5.7 MB of lhr-*.json /
# lhr-*.html per run. CI uploads this directory as a workflow artifact
# (.github/workflows/lighthouse.yml), so it is build output, never source.
.lighthouseci

# coverage.py data/report artifacts (Python services). `coverage` above only matches a path named
# exactly that, so the dotfile data file and the generated reports were NOT ignored — running
# `pytest --cov` in any service left a committable SQLite file behind. `.coveragerc` is CONFIG and
# stays tracked, so it must not be caught by these patterns.
.coverage
.coverage.*
coverage.xml
htmlcov/

# `go test -coverprofile` drops coverage.out in each Go module — the go-tests job writes one per
# matrix entry now that the QM-1 Go floor is gated (§35.13 ESC-23). Per-run artifact; the numbers
# live in the CI log.
coverage.out

# Expo local state/cache (apps/mobile) — regenerated per machine, must not be committed (expo-doctor)
.expo/

# next-env.d.ts is generated by Next.js and rewritten by every `next dev` / `next build` /
# `next typegen` — its `import './.next/…/types/routes.d.ts'` line differs between dev and build, so a
# tracked copy produces a diff every time a developer switches commands. Next's own guidance:
# "next-env.d.ts is managed by Next.js. Its contents are an implementation detail and may change over
# time. Add it to .gitignore. If your project already tracks the file, remove it from Git."
# (https://nextjs.org/docs/app/api-reference/config/typescript). It stays in tsconfig.json `include`.
apps/web/next-env.d.ts

# Serwist (@serwist/turbopack) serves the service worker from the /serwist/[path] route handler
# (bundled into .next at build time), so no service-worker artifacts land in apps/web/public — ADR-047.
# The former next-pwa public/ artifacts (sw.js, workbox-*.js, fallback-*.js) are no longer generated.


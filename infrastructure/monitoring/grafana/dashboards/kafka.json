{
  "title": "COS — Kafka",
  "uid": "cos-kafka",
  "tags": ["cos", "kafka"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "options": [{ "value": "1m" }, { "value": "5m" }, { "value": "15m" }],
        "current": { "value": "5m" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer Lag per Group",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kafka_consumer_lag",
          "legendFormat": "{{consumer_group}}/{{topic}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DLQ Depth",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(kafka_dlq_depth)",
          "legendFormat": "DLQ Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "EMPTY", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Messages Produced (per/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_messages_produced_total[$interval]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Messages Consumed (per/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (topic, consumer_group) (rate(kafka_messages_consumed_total[$interval]))",
          "legendFormat": "{{topic}}/{{consumer_group}}"
        }
      ]
    }
  ]
}

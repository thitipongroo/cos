{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "preserveWatchOutput": true,
    "paths": {
      "@cos/shared": ["./packages/@cos/shared/src/index.ts"],
      "@cos/shared/*": ["./packages/@cos/shared/src/*"],
      "@cos/rbac": ["./packages/@cos/rbac/src/index.ts"],
      "@cos/rbac/*": ["./packages/@cos/rbac/src/*"],
      "@cos/logger": ["./packages/@cos/logger/src/index.ts"],
      "@cos/logger/*": ["./packages/@cos/logger/src/*"],
      "@cos/tracing": ["./packages/@cos/tracing/src/index.ts"],
      "@cos/tracing/*": ["./packages/@cos/tracing/src/*"],
      "@cos/financial": ["./packages/@cos/financial/src/index.ts"],
      "@cos/financial/*": ["./packages/@cos/financial/src/*"],
      "@cos/types": ["./packages/@cos/types/src/index.ts"],
      "@cos/types/*": ["./packages/@cos/types/src/*"],
      "@cos/config": ["./packages/@cos/config/src/index.ts"],
      "@cos/config/*": ["./packages/@cos/config/src/*"],
      "@cos/validation": ["./packages/@cos/validation/src/index.ts"],
      "@cos/validation/*": ["./packages/@cos/validation/src/*"],
      "@cos/database": ["./packages/@cos/database/src/index.ts"],
      "@cos/database/*": ["./packages/@cos/database/src/*"],
      "@cos/ui-logic": ["./packages/@cos/ui-logic/src/index.ts"],
      "@cos/ui-logic/*": ["./packages/@cos/ui-logic/src/*"]
    }
  }
}
